<?php

/**
 * @file
 * xClaro module description and metadata.
 */

use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\Core\Path\CurrentPathStack;

/**
 * Implements hook_help().
 */
function xclaro_help($route_name, \Drupal\Core\Routing\RouteMatchInterface $route_match) {
  switch ($route_name) {
    case 'help.page.xclaro':
      return '<p>' . t('xClaro provides site administrators the option to display a dark administration interface using Claro.') . '</p>'
        . '<p>' . t('For a full description, visit the <a href="https://www.drupal.org/project/xclaro">project page</a>.') . '</p>'
        . '<p>' . t('Submit bug reports and feature suggestions, or track changes in the <a href="https://www.drupal.org/project/issues/xclaro">issue queue</a>.') . '</p>';
  }
}

/**
 * Provides metadata about the module.
 *
 * @return array
 *   An associative array containing:
 *   - description: A short description of the module.
 *   - package: The category under which the module should appear.
 */
function xclaro_info() {
  return [
    'description' => t('Provides a dark administration interface for the Claro theme.'),
    'package' => t('Administration'),
  ];
}

/**
 * Implements hook_page_attachments().
 */
function xclaro_page_attachments(array &$attachments) {
  // Check if the current theme is Claro.
  $current_theme = \Drupal::theme()->getActiveTheme()->getName();
  if ($current_theme !== 'claro') {
    return;
  }

  // Check if the current route is an admin route.
  $route_match = \Drupal::routeMatch();
  if ($route_match->getRouteObject()?->getOption('_admin_route')) {
    $attachments['#attached']['html_head'][] = [
      [
        '#tag' => 'script',
        '#attributes' => ['type' => 'text/javascript'],
        '#value' => "document.documentElement.classList.add('make-me-dark');",
      ],
      'xclaro',
    ];
    // Attach the library.
    $attachments['#attached']['library'][] = 'xclaro/xclaro';
  }
}
